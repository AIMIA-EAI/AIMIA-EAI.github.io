{
  "name": "aimia-eai-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/prepare-public.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "node scripts/validate-content.mjs && node scripts/prepare-public.mjs && pnpm typecheck && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-site.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "node scripts/validate-content.mjs && node scripts/check-site.mjs",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "metrics:github": "node scripts/update-github-metrics.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.25.0"
}
