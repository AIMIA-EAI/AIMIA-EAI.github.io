---
import widget from '../../../data/visitor-widget.json';
import { SITE_URL } from '../../../../site.config.mjs';
export function getStaticPaths() {
  return ['en', 'zh'].map((lang) => ({ params: { lang } }));
}
const zh = Astro.params.lang === 'zh';
const title = zh ? 'AIMIA 访问地图' : 'AIMIA visitor map';
const src = new URL('https://mapmyvisitors.com/map.js');
src.search = new URLSearchParams({
  d: widget.flatMapId,
  cl: '9aa68f',
  co: 'f7f7f2',
  ct: '485448',
  w: 'a',
}).toString();
---

<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={title} />
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE_URL)} />
  </head>
  <body>
    <p
      class="widget-status"
      data-widget-status
      data-failed={
        zh
          ? '访问地图暂时不可用，请稍后再试。'
          : 'Visitor map is temporarily unavailable. Please try again later.'
      }
    >
      {zh ? '正在加载访问地图…' : 'Loading visitor map…'}
    </p>
    <div class="widget-content">
      <script is:inline type="text/javascript" id="mapmyvisitors" src={src.href} async></script>
    </div>
    <noscript>
      <p>
        {zh ? '启用 JavaScript 后可查看访问地图。' : 'Enable JavaScript to view the visitor map.'}
      </p>
    </noscript>
    <script is:inline>
      const status = document.querySelector('[data-widget-status]');
      let previousHeight = 0;
      const host = document.querySelector('.widget-content');
      const sendHeight = () => {
        const height = Math.ceil(host.getBoundingClientRect().height + (status.hidden ? 0 : status.getBoundingClientRect().height));
        if (height === previousHeight) return;
        previousHeight = height;
        window.parent.postMessage({ type: 'aimia-visitor-height', height }, '*');
      };
      const observe = () => {
        const widget = document.querySelector('#mapmyvisitors-widget');
        const ready = widget && widget.querySelector('svg, img');
        if (ready) {
          status.hidden = true;
          const width = widget.offsetWidth;
          const scale = width > 0 ? Math.min(1, host.clientWidth / width) : 1;
          widget.style.transformOrigin = 'top left';
          widget.style.transform = `scale(${scale})`;
          host.style.height = `${Math.ceil(widget.offsetHeight * scale)}px`;
        }
        sendHeight();
      };
      new MutationObserver(observe).observe(host, { childList: true, subtree: true });
      new ResizeObserver(observe).observe(host);
      window.addEventListener('resize', observe);
      document.querySelector('#mapmyvisitors')?.addEventListener('error', () => {
        status.textContent = status.dataset.failed;
        sendHeight();
      });
      setTimeout(() => {
        if (!status.hidden) {
          status.textContent = status.dataset.failed;
          sendHeight();
        }
      }, 15000);
      document.addEventListener('click', (event) => {
        if (event.defaultPrevented) return;
        if (
          event.target instanceof Element &&
          event.target.closest('.jvectormap-zoomin, .jvectormap-zoomout')
        )
          return;
        const link = event.target instanceof Element ? event.target.closest('a') : null;
        if (!link) return;
        event.preventDefault();
        const url = new URL(link.href, 'https://mapmyvisitors.com/');
        if (url.hostname === 'mapmyvisitors.com') {
          url.protocol = 'https:';
          window.open(url.href, '_blank', 'noopener,noreferrer');
        }
      });
      sendHeight();
    </script>
  </body>
</html>
<style is:inline>
  html {
    background: #f7f7f2;
  }
  body {
    margin: 0;
    padding: 0;
    color: #485448;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif;
    font-size: 14px;
  }
  html, body { width: 100%; overflow: hidden; }
  .widget-content { width: 100%; position: relative; }
  #mapmyvisitors-widget { margin: 0 !important; }
  .widget-status[hidden] { display: none; }
  .widget-status {
    padding: 16px 0;
    text-align: center;
    margin: 0;
    line-height: 1.8;
  }
  .jvectormap-marker {
    fill: #a9473b;
    stroke: #f7f7f2;
  }
  #mapmyvisitors-widget {
    max-width: none;
  }
</style>
