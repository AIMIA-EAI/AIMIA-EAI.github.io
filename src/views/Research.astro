---
import Layout from '../layouts/Layout.astro';
import PublicationArchive from '../components/PublicationArchive.astro';
import ResearchUpdates from '../components/ResearchUpdates.astro';
import Icon from '../components/Icon.astro';
import lab from '../data/lab.json';
import zh from '../data/zh.json';
import { papers } from '../lib/content';
import { localePath, localizeDirections, type Locale } from '../lib/i18n';
interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const t = (en: string, cn: string) => (isZh ? cn : en);
const directions = localizeDirections(lang);
const honors = [...(isZh ? zh.honors : lab.honors)].sort((a, b) => b.year - a.year);
---

<Layout
  lang={lang}
  title={t('Research Outputs', '研究成果')}
  canonicalPath="/research/"
  description={t(
    'AIMIA research in embodied intelligence, multimodal intelligence and AI for Science (AI4S), with projects and datasets.',
    '北京大学 AIMIA 实验室围绕具身智能、多模态智能与 AI for Science（AI4S）开展研究，探索相关项目、数据集和科学问题。',
  )}
>
  <header class="container page-header page-header-split">
    <div>
      <span class="eyebrow">{t('AIMIA · PEKING UNIVERSITY', 'AIMIA · 北京大学')}</span>
      <h1>{t('Research Outputs', '研究成果')}</h1>
    </div>
    <p class="page-description">
      {t(
        'Our research focuses on embodied intelligence, multimodal intelligence and AI for Science (AI4S), spanning physical interaction, vision-language understanding and generation, and scientific prediction.',
        '我们的研究聚焦具身智能、多模态智能与 AI for Science（AI4S），涵盖物理世界交互、视觉与语言的理解和生成，以及科学预测。',
      )}
    </p>
  </header>
  <div class="container page-content">
    <nav class="research-index" aria-label={t('Research content', '研究内容')}>
      <a href="#directions">{t('Research areas', '研究方向')}</a>
      <a href="#results">{t('Research outputs', '研究成果')}</a>
    </nav>
    <div class="research-details" id="directions">
      {directions.map((d) => {
        const hasPublications = papers.some((paper) => paper.researchAreas.includes(d.tag));
        return (
          <section class="research-detail" id={d.id}>
            <span class="mono">{d.number}</span>
            <div>
              <h2>{d.title}</h2>
              <div class="tag-list">
                {d.keywords.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
            <div>
              <p class="research-description">{d.description}</p>
              <a
                class="text-link"
                href={localePath(
                  hasPublications ? `/publications/?topic=${d.tag}` : '/join/#contact',
                  lang,
                )}
              >
                {hasPublications
                  ? t('Related outputs', '相关成果')
                  : t('Research enquiries', '研究交流')}
                <Icon name="external" size={16} />
              </a>
            </div>
          </section>
        );
      })}
    </div>
    <PublicationArchive lang={lang} />
    <section class="resource-block" id="recognition">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{t('LAB RECORD', '实验室记录')}</span>
          <h2>{t('Honors & awards', '荣誉与奖励')}</h2>
        </div>
      </div>
      <div class="recognition-list">
        {honors.map((honor) => (
          <article class="recognition-item" id={honor.id}>
            <span class="mono">{honor.year}</span>
            <p>
              {honor.text}
              {'url' in honor && honor.url && (
                <a
                  class="recognition-source"
                  href={honor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t('Source', '来源')} <Icon name="external" size={13} />
                </a>
              )}
            </p>
          </article>
        ))}
      </div>
    </section>
    <details class="disclosure research-updates" id="updates">
      <summary>{t('Publication announcements & archive', '论文录用与历史动态')}</summary>
      <ResearchUpdates lang={lang} />
    </details>
  </div>
</Layout>
<style>
  .recognition-source {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 8px;
    color: var(--red);
    font-size: 14px;
    white-space: nowrap;
  }
  .research-index {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 30px;
    padding-bottom: 25px;
    border-bottom: 1px solid var(--line);
  }
  .research-index a {
    font-size: 17px;
    font-weight: 550;
  }
  .research-index a:hover {
    color: var(--red);
  }
  .research-updates {
    margin-top: 50px;
  }
  .research-updates :global(.news-archive) {
    padding-top: 28px;
  }
</style>
