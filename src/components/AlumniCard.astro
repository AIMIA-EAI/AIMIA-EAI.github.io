---
import ProfileLink from './ProfileLink.astro';
import { media } from '../lib/content';
import { translateRole, translateTerm, type Locale } from '../lib/i18n';

interface Props {
  lang?: Locale;
  headingLevel?: 'h3' | 'h4' | 'h5';
  showCohort?: boolean;
  compact?: boolean;
  person: {
    id: string;
    name: string;
    image: string | null;
    role: string;
    group?: string;
    cohort: number | null;
    destination?: string | null;
    destinationHomepage?: string | null;
    homepage: string | null;
  };
}
const { person, lang = 'en', headingLevel = 'h3', showCohort = true, compact = false } = Astro.props;
const NameHeading = headingLevel;
const zh = lang === 'zh';
const initials = person.name
  .trim()
  .split(/\s+/)
  .map((part) => part[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
const headingId = `alumni-name-${person.id}`;
---

<article class:list={['alumni-item', { 'alumni-compact': compact }]} data-alumni={person.id} aria-labelledby={headingId}>
  <div class="alumni-name">
    <NameHeading id={headingId}>{person.name}</NameHeading>
    {person.homepage && <ProfileLink href={person.homepage} personName={person.name} lang={lang} />}
  </div>
  <div class="portrait-wrap alumni-portrait">
    {person.image ? (
      <img src={media(person.image)} alt={person.name} loading="lazy" width="160" height="200" />
    ) : (
      <div
        class="portrait-placeholder"
        role="img"
        aria-label={zh ? `${person.name} — 暂无照片` : `${person.name} — no portrait available`}
      >
        <span aria-hidden="true">{initials}</span>
        <small aria-hidden="true">AIMIA</small>
      </div>
    )}
  </div>
  <div class="alumni-details">
    <p class="alumni-role">
      {translateRole(person.group || person.role, lang)}
      {showCohort && person.cohort && (
        <span class="alumni-cohort">
          {' · '}
          {zh ? `${person.cohort} 级` : `Entered ${person.cohort}`}
        </span>
      )}
    </p>
    {person.destination && (
      <p class="alumni-destination">
        {person.destinationHomepage ? (
          <a
            href={person.destinationHomepage}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${translateTerm(person.destination, lang)}${zh ? '（课题组网页，在新标签页打开）' : ' (research group website, opens in a new tab)'}`}
          >
            {translateTerm(person.destination, lang)} <span aria-hidden="true">↗</span>
          </a>
        ) : (
          translateTerm(person.destination, lang)
        )}
      </p>
    )}
  </div>
</article>

<style>
  .alumni-item {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    grid-template-areas: 'portrait name' 'portrait details';
    grid-template-rows: auto 1fr;
    column-gap: 22px;
    align-items: start;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .alumni-compact {
    grid-template-areas: 'name name' 'portrait details';
    grid-template-rows: auto 1fr;
    row-gap: 12px;
    column-gap: 16px;
  }
  .alumni-portrait {
    grid-area: portrait;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: #eaede2;
  }
  .alumni-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    filter: saturate(0.78);
    transition: filter 350ms;
  }
  .alumni-item:hover .alumni-portrait img {
    filter: saturate(1);
  }
  .alumni-portrait .portrait-placeholder {
    height: 100%;
    color: #75826b;
  }
  .alumni-portrait .portrait-placeholder > span {
    font-size: 26px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }
  .alumni-portrait .portrait-placeholder > small {
    font-size: 9px;
    line-height: 1.2;
    letter-spacing: 0.12em;
    margin-top: 7px;
  }
  .alumni-details {
    grid-area: details;
    min-width: 0;
  }
  .alumni-name {
    grid-area: name;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 2px 14px;
    flex-wrap: nowrap;
  }
  .alumni-name :is(h3, h4, h5) {
    min-width: 0;
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .alumni-item .alumni-role {
    font-size: 15px;
    line-height: 1.7;
    margin-top: 5px;
    color: var(--red);
  }
  .alumni-cohort {
    color: var(--muted);
  }
  .alumni-item .alumni-destination {
    font-size: 15px;
    line-height: 1.7;
    margin-top: 7px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .alumni-destination a {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
  }
  .alumni-destination a:hover {
    color: var(--red);
    text-decoration-color: currentColor;
  }
  @media (max-width: 700px) {
    .alumni-item {
      grid-template-columns: 116px minmax(0, 1fr);
      column-gap: 18px;
      padding-block: 18px;
    }
  }
  @media (max-width: 480px) {
    .alumni-item {
      grid-template-areas: 'name name' 'portrait details';
      grid-template-rows: auto auto;
      row-gap: 12px;
    }
  }
  @media (max-width: 380px) {
    .alumni-item {
      grid-template-columns: 100px minmax(0, 1fr);
      column-gap: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .alumni-portrait img {
      transition: none;
    }
  }
</style>
