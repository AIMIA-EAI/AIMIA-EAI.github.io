---
import { researchOutputs } from '../lib/research-outputs';
import Icon from '../components/Icon.astro';
import PaperRow from '../components/PaperRow.astro';
import { legacyTopics } from '../lib/content';
import { topicLabels, type Locale } from '../lib/i18n';
interface Props {
  lang?: Locale;
}
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const t = (en: string, cn: string) => (isZh ? cn : en);
const topics = topicLabels(lang);
import resources from '../data/resources.json';
const outputs = researchOutputs(lang);
const years = [...new Set(outputs.flatMap((p) => (p.year ? [p.year] : [])))].sort((a, b) => b - a);
const groups = [...years, ...(outputs.some((p) => !p.year) ? [null] : [])].map((year) => ({
  year,
  id: `outputs-${year ?? 'ongoing'}`,
  items: outputs.filter((item) => item.year === year),
}));
const yearRange = `${Math.min(...years)}–${Math.max(...years)}`;
---

<section
  class="publication-archive resource-block"
  id="results"
  aria-label={t('Research outputs', '研究成果')}
>
  <span id="publications" class="archive-anchor" />
  <span id="projects" class="archive-anchor" />
  <span id="datasets" class="archive-anchor" />
  <div class="section-heading">
    <div>
      <span class="eyebrow">{t('RESEARCH OUTPUTS', 'RESEARCH OUTPUTS')}</span>
      <h2>{t('Research outputs', '研究成果')}</h2>
    </div>
  </div>
  <p class="publication-intro">
    {t(
      'Explore our work by title, author, keyword, year or research area.',
      '按题名、作者、关键词、年份或研究方向，浏览课题组研究成果。',
    )}
  </p>
  <form id="publication-filters" class="archive-toolbar" role="search" onsubmit="return false">
    <label class="search-box">
      <Icon name="search" size={17} />
      <input
        id="paper-search"
        type="search"
        placeholder={t('Search titles, authors or keywords', '搜索题名、作者或关键词')}
        aria-label={t('Search research outputs', '搜索研究成果')}
        autocomplete="off"
      />
    </label>
    <label class="sr-only" for="paper-year">
      {t('Year', '年份')}
    </label>
    <select class="filter-select" id="paper-year">
      <option value="">{t('All years', '全部年份')}</option>
      {years.map((y) => (
        <option value={y}>{y}</option>
      ))}
    </select>
    <label class="sr-only" for="paper-topic">
      {t('Research area', '研究方向')}
    </label>
    <select class="filter-select" id="paper-topic">
      <option value="">{t('All research areas', '全部研究方向')}</option>
      {Object.entries(topics).map(([value, label]) => (
        <option value={value}>{label}</option>
      ))}
      {Object.entries(legacyTopics).map(([value, label]) => (
        <option value={value} hidden data-legacy="true">
          {isZh
            ? (
                {
                  generative: '生成式方法（历史主题）',
                  medical: '医学影像（历史主题）',
                  vision: '计算机视觉（历史主题）',
                } as Record<string, string>
              )[value]
            : label}
        </option>
      ))}
    </select>
    <button class="filter-reset" type="reset">
      {t('Reset', '重置')}
    </button>
  </form>
  <p class="results-count" aria-live="polite" id="paper-count" data-year-range={yearRange}>
    {isZh
      ? `${outputs.length} 项成果 · ${yearRange}`
      : `${outputs.length} research outputs · ${yearRange}`}
  </p>
  <nav class="archive-years" aria-label={t('Jump to a year', '按年份浏览')}>
    {groups.map((group) => (
      <a href={`#${group.id}`} data-year-jump={String(group.year ?? '')}>
        {group.year ?? t('Ongoing', '项目与平台')}
        <span data-jump-count>{group.items.length}</span>
      </a>
    ))}
  </nav>
  <div class="paper-list">
    {groups.map((group) => (
      <section
        class="output-year"
        id={group.id}
        data-output-year
        aria-labelledby={`${group.id}-heading`}
      >
        <header class="output-year-heading">
          <h3 id={`${group.id}-heading`}>{group.year ?? t('Ongoing', '项目与平台')}</h3>
          <span>
            <b data-year-count>{group.items.length}</b> {t('outputs', '项成果')}
          </span>
          <div class="year-line" aria-hidden="true" />
        </header>
        <div class="year-output-grid">
          {group.items.map((paper) => (
            <PaperRow paper={paper} lang={lang} />
          ))}
        </div>
      </section>
    ))}
    <p class="empty-state" id="paper-empty" hidden>
      {t(
        'No research outputs match these filters. Try another title, author or research area.',
        '未找到符合条件的研究成果，请尝试其他关键词、年份或研究方向。',
      )}
    </p>
  </div>
  <div class="scholar-link">
    <p class="page-note">
      {t(
        'This archive includes the publications listed on the lab website. For a broader citation record, visit Google Scholar.',
        '此处整理了课题组网站收录的论文，更多引用记录可查阅谷歌学术。',
      )}
    </p>
    <a
      class="text-link"
      href={resources.scholarlyProfileUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t('Google Scholar', '谷歌学术')} <Icon name="external" size={15} />
    </a>
  </div>
  <details class="disclosure" id="patents">
    <summary>
      {t('Patents & software copyrights', '专利与软件著作权')}{' '}
      <span class="mono">· {resources.patents.length}</span>
    </summary>
    <ol class="ip-list">
      {resources.patents.map((p) => (
        <li>{p.originalText}</li>
      ))}
    </ol>
  </details>
</section>

<script>
  import '../scripts/publication-archive';
</script>

<style>
  .archive-years {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 32px;
  }
  .archive-years a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 14px;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }
  .archive-years a:hover,
  .archive-years a:focus-visible {
    color: var(--red);
    border-color: var(--red);
    background: #efdfd540;
  }
  .archive-years span {
    color: var(--muted);
    font-size: 11px;
  }
  .archive-years a[hidden],
  .output-year[hidden] {
    display: none;
  }
  .paper-list {
    border-top: 0;
  }
  .output-year {
    margin-top: 42px;
    scroll-margin-top: 115px;
  }
  .output-year:first-child {
    margin-top: 0;
  }
  .output-year-heading {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 18px;
  }
  .output-year-heading h3 {
    font-family: var(--mono);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 500;
    letter-spacing: -0.05em;
  }
  .output-year-heading > span {
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
  }
  .output-year-heading b {
    font-weight: 500;
  }
  .year-line {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .year-output-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }
  @media (max-width: 800px) {
    .year-output-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .archive-years {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 8px;
    }
    .archive-years a {
      flex-shrink: 0;
    }
    .output-year {
      margin-top: 32px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .archive-years a {
      transition: none;
    }
  }
  .archive-anchor {
    display: block;
    scroll-margin-top: 110px;
  }
  .publication-intro {
    margin-bottom: 24px;
    color: var(--muted);
    font-size: 17px;
  }
</style>
